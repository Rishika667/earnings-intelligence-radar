# Earnings Intelligence Radar — environment variable template.
#
# Copy this file to `.env` (git-ignored) and fill in real values locally.
# Never commit a `.env` file with real values.
#
# All values below are free-tier / no-cost credentials or contact info
# required by public data sources, per PROJECT_SPEC.md's free/public data
# constraint. No paid API keys are used in this project.

# Required by SEC EDGAR's fair-use policy: a descriptive User-Agent
# identifying the requester (e.g. "your-name your-email@example.com").
SEC_EDGAR_USER_AGENT=

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Used for both FRED (current data) and ALFRED (point-in-time vintages).
FRED_API_KEY=

# Free API key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Free API token from https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_KEY=

# General application environment. development | production
EIR_ENVIRONMENT=development
